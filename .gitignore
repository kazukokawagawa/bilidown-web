# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# bilidown-web runtime data
/data/
/downloads/
# local logs
*.log

# electron-builder output
/release/

# 浏览器端 ffmpeg.wasm 静态资源（由 scripts/prepare-ffmpeg-wasm.mjs 从 node_modules 生成）
/public/ffmpeg/
.workbuddy/*