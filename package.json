{
  "name": "bilidown-web",
  "version": "0.2.0",
  "private": true,
  "description": "bilidown - B站视频下载器（Next.js 网站 + Electron 桌面版）",
  "author": "bilidown-web contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c cyan,magenta \"next dev -p 3100\" \"wait-on http://127.0.0.1:3100 && electron .\"",
    "electron:start": "cross-env BILIDOWN_EMBEDDED=1 electron .",
    "electron:smoke": "cross-env BILIDOWN_EMBEDDED=1 electron . --smoke-test",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win portable",
    "start:standalone": "node scripts/start-standalone.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "vip.zhouql.bilidown.desktop",
    "productName": "bilidown",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/logo.ico"
    },
    "portable": {
      "artifactName": "bilidown-${version}-portable.${ext}"
    }
  }
}
